# Public Entra application settings. Replace placeholders locally.
NEXT_PUBLIC_ENTRA_CLIENT_ID=
NEXT_PUBLIC_ENTRA_TENANT_ID=
NEXT_PUBLIC_ENTRA_REDIRECT_URI=http://localhost:3000

# Server-only Cosmos DB settings. Do not prefix these with NEXT_PUBLIC_.
COSMOS_ENDPOINT=https://<cosmos-account>.documents.azure.com:443/
COSMOS_DATABASE=office-rhythm
# Use managed-identity in Azure and DefaultAzureCredential locally after `az login`.
COSMOS_AUTH_MODE=managed-identity
# Only required for local key-based access. Leave empty when using managed identity.
COSMOS_KEY=
