{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-game.local/schemas/beatmap.schema.json",
  "title": "Office Rhythm Beatmap",
  "type": "object",
  "required": ["id", "bpm", "timeSignature", "events", "sections"],
  "properties": {
    "id": { "const": "office-day-01" },
    "bpm": { "const": 110 },
    "timeSignature": {
      "type": "array",
      "prefixItems": [{ "const": 4 }, { "const": 4 }],
      "minItems": 2,
      "maxItems": 2
    },
    "events": {
      "type": "array",
      "minItems": 90,
      "maxItems": 120,
      "items": { "$ref": "#/$defs/event" }
    },
    "sections": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        { "allOf": [{ "$ref": "#/$defs/section" }, { "type": "object", "properties": { "id": { "const": "arrival" }, "startMs": { "const": 0 }, "endMs": { "const": 19636 } } }] },
        { "allOf": [{ "$ref": "#/$defs/section" }, { "type": "object", "properties": { "id": { "const": "keyboard" }, "startMs": { "const": 19636 }, "endMs": { "const": 39273 } } }] },
        { "allOf": [{ "$ref": "#/$defs/section" }, { "type": "object", "properties": { "id": { "const": "mail" }, "startMs": { "const": 39273 }, "endMs": { "const": 58909 } } }] },
        { "allOf": [{ "$ref": "#/$defs/section" }, { "type": "object", "properties": { "id": { "const": "meeting" }, "startMs": { "const": 58909 }, "endMs": { "const": 78545 } } }] },
        { "allOf": [{ "$ref": "#/$defs/section" }, { "type": "object", "properties": { "id": { "const": "copy" }, "startMs": { "const": 78545 }, "endMs": { "const": 98182 } } }] },
        { "allOf": [{ "$ref": "#/$defs/section" }, { "type": "object", "properties": { "id": { "const": "departure" }, "startMs": { "const": 98182 }, "endMs": { "const": 120000 } } }] }
      ],
      "items": false
    }
  },
  "$defs": {
    "sectionId": {
      "enum": ["arrival", "keyboard", "mail", "meeting", "copy", "departure"]
    },
    "section": {
      "type": "object",
      "required": ["id", "startMs", "endMs"],
      "properties": {
        "id": { "$ref": "#/$defs/sectionId" },
        "startMs": { "type": "integer", "minimum": 0 },
        "endMs": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["id", "type", "startMs", "section"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["tap", "hold"] },
        "startMs": { "type": "integer", "minimum": 0 },
        "endMs": { "type": "integer", "minimum": 1 },
        "section": { "$ref": "#/$defs/sectionId" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "hold" } } },
          "then": {
            "required": ["endMs"],
            "properties": {
              "endMs": { "type": "integer", "minimum": 1 }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
